    "@types/lodash": "^4.17.15",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.12.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
