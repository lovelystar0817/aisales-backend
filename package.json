{
  "name": "aisales-backend",
  "version": "1.0.0",
  "description": "AI Sales Backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "serve": "node --import ./dist/instrument.mjs --max-old-space-size=4096 dist/server.js",
    "start": "npm run serve",
    "dev": "NODE_ENV=development tsx watch ./src/server.ts",
    "dev:nowatch": "NODE_ENV=development tsx ./src/server.ts",
    "format": "npx prettier -c ./src --write",
    "lint": "prettier --check ./src",
    "lint:fix": "prettier --write ./src",
    "test": "NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules --experimental-specifier-resolution=node --no-deprecation\" vitest run",
    "test:watch": "NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules --experimental-specifier-resolution=node --no-deprecation\" vitest",
    "test:coverage": "NODE_ENV=test NODE_OPTIONS=\"--experimental-vm-modules --experimental-specifier-resolution=node --no-deprecation\" vitest run --coverage",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org hupo-ve --project aisales-backend ./dist && sentry-cli sourcemaps upload --org hupo-ve --project aisales-backend ./dist",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Hupo Product",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@adminjs/mongoose": "^4.1.0",
    "@aws-sdk/client-s3": "^3.837.0",
    "@aws-sdk/s3-request-presigner": "^3.837.0",
    "@deepgram/sdk": "^4.11.3",
    "@fastify/auth": "^5.0.2",
    "@fastify/autoload": "^6.0.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/env": "^5.0.2",
    "@fastify/express": "^4.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/session": "^11.1.0",
    "@hokify/agenda": "^6.3.0",
    "@langchain/anthropic": "^0.3.12",
    "@langchain/core": "^0.3.42",
    "@langchain/openai": "^0.4.2",
    "@livekit/protocol": "^1.39.0",
    "@opentelemetry/api-logs": "^0.213.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
